    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "path-browserify": "1.0.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
